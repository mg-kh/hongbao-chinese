model QuizSection {
  id          String     @id @default(uuid())
  quizId      String
  title       String
  description String?
  order       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  audioUrl    String?
  timeLimit   Int?
  questions   Question[]
  quiz        Quiz       @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}
