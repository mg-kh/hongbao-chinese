model SubLesson {
  id          String          @id @default(uuid())
  lessonId    String
  title       String
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  lesson      Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  quizzes     SubLessonQuiz[]
  videos      Video[]

  @@index([lessonId])
}
